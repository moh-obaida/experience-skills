    { "input": "our CLI asks too many questions during setup", "expected": ["workflow-compression", "interaction-design"], "notExpected": ["visual-identity"] },
    { "input": "the product has gotten confusing as we added features", "expected": ["product-friction"], "notExpected": ["motion-design"] },
    { "input": "I love this glassmorphism idea for our tax form, should we ship it?", "expected": ["critical-review", "anti-slop-ui"], "notExpected": [] },
