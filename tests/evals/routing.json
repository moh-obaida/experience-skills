    { "input": "this settings flow takes 12 clicks", "expected": ["workflow-compression", "product-friction"], "notExpected": ["motion-design"] },
    { "input": "the page is clean but looks blank and generic", "expected": ["composition-repair", "visual-identity", "anti-slop-ui"], "notExpected": ["workflow-compression"] },
    { "input": "animation is just fades", "expected": ["motion-design", "state-design"], "notExpected": ["empty-state-design"] },
    { "input": "mobile layout overflows", "expected": ["responsive-validation", "composition-repair"], "notExpected": ["visual-identity"] },
    { "input": "do you think my redesign is good?", "expected": ["critical-review"], "notExpected": [] },
    { "input": "our join page has fancy code boxes but the page feels empty", "expected": ["composition-repair", "visual-identity", "interaction-design", "anti-slop-ui"], "notExpected": [] },
    { "input": "users keep asking support where the export button is", "expected": ["product-friction", "interaction-design"], "notExpected": ["motion-design"] },
    { "input": "the error just says something went wrong", "expected": ["state-design"], "notExpected": ["visual-identity"] },
    { "input": "the library is empty for new users and looks broken", "expected": ["empty-state-design", "composition-repair"], "notExpected": ["motion-design"] },
    { "input": "the host has separate correct and wrong buttons for every team", "expected": ["interaction-design", "workflow-compression"], "notExpected": ["visual-identity"] },
    { "input": "our landing page looks like every other AI startup", "expected": ["anti-slop-ui", "visual-identity"], "notExpected": ["state-design"] },
